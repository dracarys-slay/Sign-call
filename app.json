{
  "expo": {
    "name": "Sign Call",
    "slug": "sign-call",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1628"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.signcall.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Sign Call uses the camera for video calls and real-time sign language detection.",
        "NSMicrophoneUsageDescription": "Sign Call uses the microphone for audio during video calls.",
        "NSSpeechRecognitionUsageDescription": "Sign Call uses speech recognition for accessibility features."
      }
    },
    "android": {
      "package": "com.signcall.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#0a1628"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      "expo-av"
    ]
  }
}
