# Sign Call — Environment Variables
#
# Copy this file to .env.local and fill in the values.
# The .env.local file is gitignored and should never be committed.
#
# ── Signaling Server ──────────────────────────────────────────────────────────
#
# URL of the WebSocket signaling server used for WebRTC peer connection setup.
#
# Local development (run: cd server && npm install && node signaling.js):
EXPO_PUBLIC_SIGNALING_URL=ws://localhost:8080/ws
#
# Production example (replace with your deployed server URL):
# EXPO_PUBLIC_SIGNALING_URL=wss://your-signaling-server.example.com/ws
